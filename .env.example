# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clipearn_db?schema=public"

# Redis Cache / Background Workers (BullMQ)
REDIS_URL="redis://localhost:6379"

# Application Security & Sessions
SESSION_SECRET="clipearn_ultra_secure_jwt_session_secret_change_in_prod"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Platform Settings
PLATFORM_FEE_PERCENTAGE="3.0"
DEVELOPMENT_MODE="true"
MOCK_SOCIAL_PROVIDERS="true"

# Discord OAuth for Clippers
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_CLIENT_SECRET="your_discord_client_secret"
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"

# Social Platform APIs (Optional in Dev - Mock Provider will be used if blank)
# Meta / Instagram Graph API
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_REDIRECT_URI="http://localhost:3000/api/social-accounts/callback/instagram"

# TikTok API
TIKTOK_CLIENT_KEY="your_tiktok_client_key"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret"
TIKTOK_REDIRECT_URI="http://localhost:3000/api/social-accounts/callback/tiktok"

# Google / YouTube Data API v3
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/social-accounts/callback/youtube"

# S3-compatible Object Storage (Cloudflare R2 / AWS S3)
STORAGE_ACCESS_KEY="your_storage_access_key"
STORAGE_SECRET_KEY="your_storage_secret_key"
STORAGE_BUCKET="clipearn-assets"
STORAGE_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
